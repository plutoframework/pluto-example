                "schema": {
                  "$ref": "#/components/schemas/PurchaseResponse"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "demoBearer": []
          }
        ],
        "summary": "Read purchase request",
        "x-feature": "",
        "x-permission": "purchases:read"
      }
    },
    "/api/purchases/{purchaseID}/decision": {
      "post": {
        "description": "An approver approves or rejects a submitted request created by someone else.",
        "operationId": "purchases.decide",
        "parameters": [
          {
            "description": "Active organization, verified against token membership.",
            "in": "header",
            "name": "X-Organization-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "purchaseID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseResponse"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "demoBearer": []
          }
        ],
        "summary": "Decide purchase request",
        "x-feature": "",
        "x-permission": "purchases:decide"
      }
    },
    "/api/purchases/{purchaseID}/submit": {
      "post": {
        "description": "The creator submits a draft for approval. Other transitions return conflict.",
        "operationId": "purchases.submit",
        "parameters": [
          {
            "description": "Active organization, verified against token membership.",
            "in": "header",
            "name": "X-Organization-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "purchaseID",
            "required": true,
