    "/auth/enroll": {
      "post": {
        "description": "POST only, exact trusted Origin required; opaque code response. No automatic business privileges. JSON is bounded to 8 KiB.",
        "operationId": "credentials.enroll",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            },
            "description": "Opaque authentication code; no credential or challenge data."
          }
        },
        "summary": "Enroll account",
        "x-feature": "",
        "x-permission": ""
      }
    },
