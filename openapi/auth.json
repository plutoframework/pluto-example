    "/auth/oidc/begin": {
      "post": {
        "description": "Trusted-Origin POST; redirects to configured provider with S256 PKCE.",
        "operationId": "oidc.begin",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OIDCAuthorizationResponse"
                }
              }
            },
            "description": "With Accept: application/json, returns the server-built authorization URL."
          },
          "303": {
            "description": "Browser redirect; no JSON success body.",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "format": "uri-reference",
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Opaque authentication error; no credential data."
          }
        },
        "summary": "Begin OIDC sign-in",
        "x-feature": "",
        "x-permission": ""
      }
    },
    "/auth/oidc/callback": {
      "get": {
        "description": "One-use browser/state/nonce callback; no automatic business grants.",
        "operationId": "oidc.callback",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
