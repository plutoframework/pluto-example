# Copy values into your shell explicitly; the application does NOT load .env files.
# DEVELOPMENT fixtures and Mailpit require the enforced loopback binding.
PLUTO_EXAMPLE_DEMO_AUTH=true
PLUTO_EXAMPLE_SERVER_ADDRESS=127.0.0.1:8080
PLUTO_EXAMPLE_SERVER_GZIP=true
PLUTO_EXAMPLE_DATABASE_MODE=postgres
# Required isolated development PostgreSQL database.
PLUTO_EXAMPLE_DATABASE_URL=postgres://pluto_demo:local_only@127.0.0.1:55432/pluto_demo?sslmode=disable
PLUTO_EXAMPLE_LOG_LEVEL=info
PLUTO_EXAMPLE_LOG_STDOUT=true
# PLUTO_EXAMPLE_LOG_FILE=./demo.log
# Missing uses declared false; an explicit false remains false.
PLUTO_EXAMPLE_FEATURE_PURCHASE_EXPORT=false

# Pluto session settings (cookies always Secure; use HTTPS for browsers).
PLUTO_EXAMPLE_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:8080,https://127.0.0.1:5173
PLUTO_EXAMPLE_AUTH_SESSION_TTL=24h
PLUTO_EXAMPLE_AUTH_IDLE_TIMEOUT=30m

# Disposable loopback SMTP capture only. Production delivery is not wired.
PLUTO_EXAMPLE_AUTH_DEVELOPMENT_SMTP=127.0.0.1:1025

# Optional data cache; auth, membership and permission checks stay authoritative.
PLUTO_EXAMPLE_CACHE_BACKEND=memory
PLUTO_EXAMPLE_CACHE_ENVIRONMENT=development
# Start docker compose --profile cache up -d --wait for a local Valkey server.
# PLUTO_EXAMPLE_CACHE_URL=redis://:local_only@127.0.0.1:6379/0
PLUTO_EXAMPLE_CACHE_ALLOW_INSECURE=false

# Optional OTLP/HTTP traces and metrics. Disabled by default; no global providers.
PLUTO_EXAMPLE_OTEL_ENABLED=false
# PLUTO_EXAMPLE_OTEL_ENDPOINT=http://127.0.0.1:4318
PLUTO_EXAMPLE_OTEL_SAMPLE_RATIO=1

# Optional read-only agent review. No provider calls unless both mode and flag opt in.
PLUTO_EXAMPLE_AGENT_MODE=off
PLUTO_EXAMPLE_FEATURE_PURCHASE_REVIEW=false
# PLUTO_EXAMPLE_AGENT_MODEL=gpt-5.4
# Supply PLUTO_EXAMPLE_AGENT_OPENAI_API_KEY privately in the environment only.
