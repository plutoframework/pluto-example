{
  "name": "pluto-purchasing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "node scripts/certificate.mjs && vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/certificate.mjs && vite preview",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "fmt": "prettier --write .",
    "lint": "eslint . && prettier --check . && node scripts/architecture.mjs",
    "test": "vitest run && node --test scripts/architecture.test.mjs scripts/theme.test.mjs",
    "test:e2e": "playwright test",
    "capture": "node scripts/capture.mjs --allow-fixture-recovery",
    "check": "npm run theme:check && npm run api:check && npm run lint && tsc --noEmit && npm test && npm run build",
    "theme:generate": "node scripts/theme.mjs",
    "theme:check": "node scripts/theme.mjs --check",
    "predev": "npm run theme:generate",
    "prebuild": "npm run theme:generate"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@plutoframework/frontend": "0.1.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
